#!/bin/bash
set -euo pipefail
# push-branch REPO_DIR BRANCH [--tag plan-approved-N]   (agent-run job; callers engineer, supervisor)
# REPO_DIR: PROJECTS_DIR/<name>, a worktree PROJECTS_DIR/<name>.wt/<id>, or RECORDS_DIR/<name> (supervisor only);
# <name> must be in ETC_DIR/projects.txt. Refuses the default branch, main, master and bad names; engineer-records
# and tags (only ^plan-approved-[0-9]+$) are for supervisor only. Fetches into the broker mirror (mirror.sh), then
# pushes from the mirror without --force; the bot PAT reaches git only as an http.extraheader in the environment.
# Prints {"branch", "sha", "tag"}. Exit: 64 usage, 65 refused, 77 caller not allowed, else git's failure.
root=$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)
# shellcheck disable=SC1091
. "$root/scripts/broker/common.sh"
need_caller
sup() { [ "$AGENT_RUN_CALLER" = supervisor ]; }

[ $# -eq 2 ] || [ $# -eq 4 ] || die 64 "usage: push-branch REPO_DIR BRANCH [--tag plan-approved-N]"
dir=${1%/}; branch=$2; tag=
if [ $# -eq 4 ]; then
  [ "$3" = --tag ] || die 64 "usage: push-branch REPO_DIR BRANCH [--tag plan-approved-N]"
  tag=$4
  sup || die 77 "only supervisor may push a tag"
  [[ "$tag" =~ ^plan-approved-[0-9]+$ ]] || die 65 "tag must match ^plan-approved-[0-9]+$"
fi

# Where the repo is decides the project name and who may push from it.
case "$dir" in /*) ;; *) die 65 "REPO_DIR must be absolute" ;; esac
case "/$dir/" in */../*|*/./*) die 65 "REPO_DIR must not contain . or .. parts" ;; esac
kind=; name=; rel=
if [ "${dir#"$PROJECTS_DIR"/}" != "$dir" ]; then
  rel=${dir#"$PROJECTS_DIR"/}
  if [[ "$rel" =~ ^([a-z0-9][a-z0-9-]{0,39})$ ]]; then kind=clone; name=${BASH_REMATCH[1]}
  elif [[ "$rel" =~ ^([a-z0-9][a-z0-9-]{0,39})\.wt/([A-Za-z0-9][A-Za-z0-9_-]{0,63})$ ]]; then kind=worktree; name=${BASH_REMATCH[1]}
  fi
elif [ "${dir#"$RECORDS_DIR"/}" != "$dir" ]; then
  rel=${dir#"$RECORDS_DIR"/}
  [[ "$rel" =~ ^([a-z0-9][a-z0-9-]{0,39})$ ]] && { kind=records; name=${BASH_REMATCH[1]}; }
fi
[ -n "$kind" ] || die 65 "REPO_DIR must be PROJECTS_DIR/<name>, PROJECTS_DIR/<name>.wt/<id> or RECORDS_DIR/<name>"
[ "$kind" != records ] || sup || die 77 "only supervisor may push from the records clone"
project_row "$name"

if [ "$branch" = engineer-records ]; then
  sup || die 77 "only supervisor may push engineer-records"
else
  branch_ok "$branch"
fi

# No symlinked path component below the base, and a .git that stays inside this project.
base=$PROJECTS_DIR; [ "$kind" = records ] && base=$RECORDS_DIR
[ -d "$dir" ] && [ "$(readlink -f "$dir")" = "$(readlink -f "$base")/$rel" ] || die 65 "REPO_DIR is missing or a symlink"
if [ "$kind" = worktree ]; then
  [ -f "$dir/.git" ] && [ ! -L "$dir/.git" ] || die 65 "worktree has no .git file"
  gd=$(sed -n '1s/^gitdir: //p' "$dir/.git")
  main=$(readlink -f "$PROJECTS_DIR/$name/.git")
  case "$(readlink -f "$gd")" in "$main"/worktrees/*) ;; *) die 65 "worktree .git points outside $name" ;; esac
  if [ -f "$gd/commondir" ]; then
    cd_=$(cat "$gd/commondir"); case "$cd_" in /*) ;; *) cd_="$gd/$cd_" ;; esac
    [ "$(readlink -f "$cd_")" = "$main" ] || die 65 "worktree commondir points outside $name"
  fi
else
  [ -d "$dir/.git" ] && [ ! -L "$dir/.git" ] || die 65 "REPO_DIR has no .git directory"
fi

refs=("+refs/heads/$branch:refs/heads/$branch")
push=("refs/heads/$branch:refs/heads/$branch")
if [ -n "$tag" ]; then
  refs+=("+refs/tags/$tag:refs/tags/$tag")
  push+=("refs/tags/$tag:refs/tags/$tag")
fi
mirror=$("$root/scripts/broker/mirror.sh" "$name" "$dir" "${refs[@]}")
sha=$(git --git-dir="$mirror" rev-parse --verify "refs/heads/$branch^{commit}")

# The PAT stays in shell variables and the environment of the one push; printf is a builtin.
pat=$(secret GH_BOT_PAT)
[ -n "$pat" ] || die 1 "GH_BOT_PAT is empty"
auth=$(printf 'x-access-token:%s' "$pat" | base64 -w0)
unset pat
GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0="http.$GITHUB_URL/.extraheader" GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $auth" \
  git --git-dir="$mirror" push --quiet --no-verify "$GITHUB_URL/$P_REPO.git" "${push[@]}" >&2 || die 1 "git push failed"
unset auth
jq -cn --arg b "$branch" --arg s "$sha" --arg t "$tag" '{branch: $b, sha: $s, tag: (if $t == "" then null else $t end)}'
