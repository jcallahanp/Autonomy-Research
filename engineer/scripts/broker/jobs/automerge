#!/bin/bash
set -euo pipefail
# automerge PROJECT PR   (agent-run job; caller supervisor)
# Self-merge is on by default (John's decision 2): requires self_merge=on for the project in projects.txt.
# Reads the PR with gh, asks scripts/checks/merge-tier.py for the tier, then:
#   tier 1 -> gh pr merge --auto --squash (pinned to the head commit); prints {"tier":1,"auto_merge":true}
#   tier 2 -> the same only when owner_login's latest decisive review on headRefOid is APPROVED;
#             otherwise prints {"tier":2,"auto_merge":false,"reasons":[...]} and exits 3.
# merge-tier failing, exiting non-zero or answering anything but tier 1 or 2 counts as tier 2 and never merges.
# Exit: 0 auto-merge enabled; 3 not merged (tier 2 without approval, unclassified, self_merge off); 64, 65, 77; 1 failure.
root=$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)
# shellcheck disable=SC1091
. "$root/scripts/broker/common.sh"
need_caller

[ $# -eq 2 ] || die 64 "usage: automerge PROJECT PR"
project=$1 pr=$2
[[ "$pr" =~ ^[1-9][0-9]{0,8}$ ]] || die 65 "PR must be a number"
project_row "$project"
if [ "$P_SELF_MERGE" != on ]; then
  jq -cn '{tier: null, auto_merge: false, reasons: ["self_merge is off for this project"]}'
  exit 3
fi

tok=$(secret GH_BOT_PAT)
[ -n "$tok" ] || die 1 "GH_BOT_PAT is empty"
view=$(GH_TOKEN=$tok gh pr view "$pr" --repo "$P_REPO" --json title,files,reviews,headRefOid) \
  || die 1 "gh pr view failed"
head=$(jq -r '.headRefOid // ""' <<<"$view")
[[ "$head" =~ ^[0-9a-f]{40}$ ]] || die 1 "gh gave no head commit"

tier_in=$(jq -c '{title: .title, files: [.files[]? | {path, additions, deletions}]}' <<<"$view")
# A failed or unreadable classification counts as Tier 2 and never merges, whatever the reviews say.
unclassified=
tier=$(python3 "$root/scripts/checks/merge-tier.py" <<<"$tier_in") || unclassified="merge-tier failed"
if [ -z "$unclassified" ]; then
  t=$(jq -r 'if (.tier == 1 or .tier == 2) and ((.reasons // []) | type) == "array" then .tier else "" end' \
    <<<"$tier" 2>/dev/null || true)
  [ -n "$t" ] || unclassified="merge-tier gave no tier 1 or 2"
fi
if [ -n "$unclassified" ]; then
  jq -cn --arg r "$unclassified; treated as tier 2, not merged" '{tier: 2, auto_merge: false, reasons: [$r]}'
  exit 3
fi
reasons=$(jq -c '.reasons // []' <<<"$tier")

approved=no
if [ "$t" = 2 ] && [ -n "$P_OWNER" ]; then
  # The owner's latest APPROVED / CHANGES_REQUESTED / DISMISSED review on the head commit decides.
  last=$(jq -r --arg o "$P_OWNER" --arg h "$head" '[.reviews[]?
      | select(.author.login == $o and .commit.oid == $h)
      | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED" or .state == "DISMISSED")]
    | last | .state // ""' <<<"$view")
  [ "$last" = APPROVED ] && approved=yes
fi

if [ "$t" = 1 ] || { [ "$t" = 2 ] && [ "$approved" = yes ]; }; then
  GH_TOKEN=$tok gh pr merge "$pr" --auto --squash --repo "$P_REPO" --match-head-commit "$head" >&2 \
    || die 1 "gh pr merge failed"
  jq -cn --argjson t "$t" '{tier: $t, auto_merge: true}'
  exit 0
fi
jq -cn --argjson r "$reasons" '{tier: 2, auto_merge: false, reasons: $r}'
exit 3
