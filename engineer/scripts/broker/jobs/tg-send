#!/usr/bin/python3 -I
"""Broker job tg-send: send stdin text to John on Telegram as the supervisor bot.

Run as secretbroker through `agent-run tg-send` (callers: supervisor). Splits the text on line
boundaries into messages of at most 4096 characters (UTF-16 units, as Telegram counts), POSTs each
to TELEGRAM_API/bot<TG_SUPERVISOR_TOKEN>/sendMessage with chat_id = secret TG_JOHN_CHAT_ID, and
prints {"sent": n}. The token never reaches argv, a log line, stdout or stderr.
"""
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / "scripts"))
from eng import brokerlib  # noqa: E402
from eng import conf as _conf  # noqa: E402

LIMIT = 4096
_TOKEN = re.compile(r"[A-Za-z0-9:_-]{1,200}")
_CHAT = re.compile(r"-?[0-9]{1,20}")


def units(s: str) -> int:
    return len(s.encode("utf-16-le", "surrogatepass")) // 2


def _cut(line: str, limit: int) -> int:
    """Largest prefix length of line that fits in limit UTF-16 units."""
    used = 0
    for i, c in enumerate(line):
        used += 2 if ord(c) > 0xFFFF else 1
        if used > limit:
            return i
    return len(line)


def chunks(text: str, limit: int = LIMIT) -> list:
    out, cur = [], ""
    for line in text.splitlines():
        while units(line) > limit:
            if cur:
                out.append(cur)
                cur = ""
            i = _cut(line, limit)
            out.append(line[:i])
            line = line[i:]
        if cur and units(cur) + 1 + units(line) > limit:
            out.append(cur)
            cur = ""
        cur = f"{cur}\n{line}" if cur else line
    out.append(cur)
    return [c.strip("\n") for c in out if c.strip()]


def _ok(body: bytes) -> bool:
    try:
        return json.loads(body).get("ok") is True
    except (ValueError, AttributeError):
        return False


def main() -> int:
    conf = _conf.load(ROOT)
    parts = chunks(sys.stdin.buffer.read().decode("utf-8", "replace"))
    if not parts:
        print(json.dumps({"sent": 0}))
        return 0
    token = brokerlib.secret(conf, "TG_SUPERVISOR_TOKEN").strip()
    chat = brokerlib.secret(conf, "TG_JOHN_CHAT_ID").strip()
    if not _TOKEN.fullmatch(token) or not _CHAT.fullmatch(chat):
        print("tg-send: TG_SUPERVISOR_TOKEN or TG_JOHN_CHAT_ID has an unexpected shape", file=sys.stderr)
        return 1
    url = f"{conf['TELEGRAM_API'].rstrip('/')}/bot{token}/sendMessage"
    sent = 0
    for part in parts:
        body = json.dumps({"chat_id": int(chat), "text": part}).encode()
        status, reply = brokerlib.http("POST", url, {"Content-Type": "application/json"}, body)
        if status != 200 or not _ok(reply):
            print(f"tg-send: sendMessage failed (HTTP {int(status)}) after {sent} of {len(parts)}", file=sys.stderr)
            print(json.dumps({"sent": sent}))
            return 1
        sent += 1
    print(json.dumps({"sent": sent}))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # never print the message: it may hold the URL, and the URL holds the token
        print(f"tg-send: failed ({type(e).__name__})", file=sys.stderr)
        sys.exit(1)
