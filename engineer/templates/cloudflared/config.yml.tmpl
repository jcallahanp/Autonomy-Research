# cloudflared tunnel config for noVNC. On setup day John runs `cloudflared tunnel login`, `tunnel create`
# and `tunnel route dns <tunnel> novnc.<domain>`, fills {{TUNNEL_ID}} and {{DOMAIN}}, and creates a
# Cloudflare Access app for novnc.<domain> whose only policy allows his one email. noVNC listens on
# 127.0.0.1 only; this tunnel is the one way in. Every other hostname gets a 404.
tunnel: {{TUNNEL_ID}}
credentials-file: /etc/cloudflared/{{TUNNEL_ID}}.json
ingress:
  - hostname: novnc.{{DOMAIN}}
    service: http://127.0.0.1:6080
  - service: http_status:404
