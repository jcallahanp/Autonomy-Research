{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUN_STATUS.json",
  "description": "Night state, written atomically by the supervisor.",
  "type": "object",
  "required": [
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "done",
        "blocked",
        "stopped_by_bound",
        "crashed",
        "waiting_for_reset"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reset_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_task": {
      "type": [
        "string",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "started": {
      "type": [
        "string",
        "null"
      ]
    },
    "ended": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
