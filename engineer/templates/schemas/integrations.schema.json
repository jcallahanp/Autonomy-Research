{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "integrations.yaml",
  "description": "docs/plan/integrations.yaml: services, auth, prices with date, the 12-point checklist and edges. Signed by John.",
  "type": "object",
  "required": [
    "services"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "auth",
          "env_vars",
          "price",
          "owner_action",
          "fallback",
          "checklist"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "description": "Same id as in architecture.yaml."
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "type": "string",
            "minLength": 1
          },
          "env_vars": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "description": "Names only, never values."
          },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount_usd",
              "period",
              "date"
            ],
            "properties": {
              "amount_usd": {
                "type": "number",
                "minimum": 0
              },
              "period": {
                "enum": [
                  "month",
                  "year",
                  "one_off",
                  "usage"
                ]
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "owner_action": {
            "type": "string"
          },
          "fallback": {
            "type": "string"
          },
          "checklist": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "auth_type",
              "token_lifetime",
              "scopes",
              "rate_limit",
              "pagination",
              "webhook_signature",
              "webhook_retries",
              "idempotency",
              "sandbox",
              "api_version",
              "plan_gating",
              "residency_terms"
            ],
            "properties": {
              "auth_type": {
                "type": "string",
                "minLength": 1
              },
              "token_lifetime": {
                "type": "string",
                "minLength": 1
              },
              "scopes": {
                "type": "string",
                "minLength": 1
              },
              "rate_limit": {
                "type": "string",
                "minLength": 1
              },
              "pagination": {
                "type": "string",
                "minLength": 1
              },
              "webhook_signature": {
                "type": "string",
                "minLength": 1
              },
              "webhook_retries": {
                "type": "string",
                "minLength": 1
              },
              "idempotency": {
                "type": "string",
                "minLength": 1
              },
              "sandbox": {
                "type": "string",
                "minLength": 1
              },
              "api_version": {
                "type": "string",
                "minLength": 1
              },
              "plan_gating": {
                "type": "string",
                "minLength": 1
              },
              "residency_terms": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "data",
          "direction"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "one-way",
              "two-way"
            ]
          }
        }
      }
    },
    "monthly_total_usd": {
      "type": "number",
      "minimum": 0
    }
  }
}
