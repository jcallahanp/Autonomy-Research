# /etc/engineer/projects.txt (root-owned, written on setup day; never in git). One project per line:
#   name owner/repo default_branch self_merge=on|off scratch=yes|no owner_login=<github-login>
# name: ^[a-z0-9][a-z0-9-]{0,39}$, the clone is /home/engineer/projects/<name>.
# self_merge=on lets the automerge broker job merge Tier 1 PRs (John's decision 2: on by default);
# Tier 2 waits for an APPROVED review by owner_login on the head commit.
# scratch=yes lets run-task start Claude sessions before setup-root --lock (throwaway projects only).
example-project example-owner/example-project main self_merge=on scratch=no owner_login=example-owner
