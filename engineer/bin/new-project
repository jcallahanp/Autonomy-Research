#!/usr/bin/env python3
"""Create a project repo tree from the engineer's skeleton (templates/project/).

Usage: new-project DIR --name NAME --owner LOGIN [--adopt]

Copies every skeleton file into DIR, replacing {{NAME}} and {{OWNER}}. Refuses a non-empty DIR
unless --adopt is given; with --adopt it copies only missing files and lists every file it
skipped. It never overwrites a file and never writes through a symlink.
Exit codes: 0 done, 1 refused (non-empty DIR, symlink in the way), 2 bad arguments.
"""
import argparse
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SKELETON = ROOT / "templates" / "project"
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
OWNER_RE = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}")


class Refused(Exception):
    pass


def parse(argv):
    p = argparse.ArgumentParser(prog="new-project", description=__doc__.splitlines()[0])
    p.add_argument("dir")
    p.add_argument("--name", required=True)
    p.add_argument("--owner", required=True, help="GitHub login of the project owner")
    p.add_argument("--adopt", action="store_true", help="add missing skeleton files to an existing repo")
    args = p.parse_args(argv)
    if not NAME_RE.fullmatch(args.name):
        p.error(f"bad --name {args.name!r}: letters, digits, '.', '_' or '-', at most 64")
    if not OWNER_RE.fullmatch(args.owner):
        p.error(f"bad --owner {args.owner!r}: not a GitHub login")
    return args


def skeleton_files():
    """Skeleton files as paths relative to SKELETON, sorted."""
    out = []
    for dirpath, dirnames, filenames in os.walk(SKELETON):
        dirnames.sort()
        for f in filenames:
            out.append(Path(dirpath, f).relative_to(SKELETON))
    return sorted(out)


def check_no_symlink(dest: Path, rel: Path) -> None:
    """Refuse when DIR itself or any existing component on the way to rel is a symlink."""
    cur = dest
    if cur.is_symlink():
        raise Refused(f"{dest} is a symlink")
    for part in rel.parts:
        cur = cur / part
        if cur.is_symlink():
            raise Refused(f"{cur} is a symlink; not writing through it")
        if not os.path.lexists(cur):
            return


def fill(text: str, name: str, owner: str) -> str:
    return text.replace("{{NAME}}", name).replace("{{OWNER}}", owner)


def write_new(path: Path, data: str) -> None:
    """Create path; never overwrite (O_EXCL) and never follow a final symlink (O_NOFOLLOW)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(data)


def plan(dest: Path, adopt: bool):
    """Return (to_write, skipped) relative paths, or raise Refused."""
    files = skeleton_files()
    if dest.is_symlink():
        raise Refused(f"{dest} is a symlink")
    if dest.exists() and not dest.is_dir():
        raise Refused(f"{dest} exists and is not a directory")
    if dest.exists() and any(dest.iterdir()) and not adopt:
        raise Refused(f"{dest} is not empty; use --adopt to add only missing files")
    to_write, skipped = [], []
    for rel in files:
        check_no_symlink(dest, rel)
        (skipped if os.path.lexists(dest / rel) else to_write).append(rel)
    return to_write, skipped


def main(argv) -> int:
    args = parse(argv)
    dest = Path(args.dir).absolute()
    try:
        to_write, skipped = plan(dest, args.adopt)
        dest.mkdir(parents=True, exist_ok=True)
        for rel in to_write:
            text = (SKELETON / rel).read_text(encoding="utf-8")
            write_new(dest / rel, fill(text, args.name, args.owner))
    except (Refused, FileExistsError, OSError) as e:
        print(f"new-project: refused: {e}", file=sys.stderr)
        return 1
    for rel in to_write:
        print(f"created {rel.as_posix()}")
    for rel in skipped:
        print(f"skipped {rel.as_posix()} (exists)")
    print(f"new-project: {len(to_write)} created, {len(skipped)} skipped in {dest}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
