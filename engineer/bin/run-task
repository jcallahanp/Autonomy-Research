#!/usr/bin/python3 -I
"""run-task PROJECT TASK_ID PROFILE [--resume SESSION_ID] [--dry-run]

Sudo target (supervisor -> engineer). Creates or reuses the worktree PROJECTS_DIR/<p>.wt/<id> on branch
task/<id> from the project's default branch (fetched first from the broker mirror, scripts/runtask/worktree.py),
then runs one profile from templates/run-defaults.yaml:
`check` runs the task's check command under `timeout`; every other profile runs a fixed `claude -p` argv
built here (the caller passes no command, flag or prompt). Prints one run-result JSON line and exits 0;
with --dry-run prints {"argv", "cwd", "env"} and changes nothing.
Refusals (message on stderr): 64 usage; 65 bad project, task, profile or resume; 75 kill switch, or not
locked for a non-check profile on a non-scratch project; 78 an Anthropic key or token is set (REFUSED_ENV).
"""
import json
import os
import pwd
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))

import yaml  # noqa: E402

from eng import conf as engconf, schema  # noqa: E402
from runtask import worktree  # noqa: E402

PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
SESSION_RE = re.compile(r"^[0-9a-f-]{36}$")
TAIL_LINES = 200
REFUSED_ENV = ("ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_AUTH_TOKEN")


class Refuse(Exception):
    def __init__(self, code: int, msg: str):
        super().__init__(msg)
        self.code = code


def parse_args(argv: list) -> dict:
    args = {"resume": None, "dry_run": False, "pos": []}
    it = iter(argv)
    for a in it:
        if a == "--dry-run":
            args["dry_run"] = True
        elif a == "--resume":
            args["resume"] = next(it, "")
        elif a.startswith("--"):
            raise Refuse(64, f"unknown option {a}")
        else:
            args["pos"].append(a)
    if len(args["pos"]) != 3:
        raise Refuse(64, "usage: run-task PROJECT TASK_ID PROFILE [--resume SESSION_ID] [--dry-run]")
    return args


def project_row(conf: dict, name: str) -> dict:
    path = Path(conf["ETC_DIR"]) / "projects.txt"
    for line in path.read_text().splitlines() if path.exists() else []:
        parts = line.split()
        if len(parts) >= 3 and not parts[0].startswith("#") and parts[0] == name:
            row = {"repo": parts[1], "default": parts[2]}
            row.update(kv.split("=", 1) for kv in parts[3:] if "=" in kv)
            if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]*", row["default"]):
                raise Refuse(65, f"bad default branch for {name}")
            return row
    raise Refuse(65, f"project not in projects.txt: {name}")


def find_task(clone: Path, task_id: str) -> dict:
    s = schema.load(ROOT, "tasks")
    if not re.fullmatch(s["properties"]["tasks"]["items"]["properties"]["id"]["pattern"], task_id):
        raise Refuse(65, "bad task id")
    try:
        doc = json.loads((clone / "docs" / "plan" / "tasks.json").read_text())
    except (OSError, ValueError) as e:
        raise Refuse(65, f"cannot read docs/plan/tasks.json: {type(e).__name__}")
    for t in doc.get("tasks", []) if isinstance(doc, dict) else []:
        if isinstance(t, dict) and t.get("id") == task_id:
            return t
    raise Refuse(65, f"task {task_id} not in docs/plan/tasks.json")


def build(conf: dict, a: dict, profiles: dict, task: dict, wt: Path) -> tuple:
    project, task_id, profile = a["pos"]
    p = profiles[profile]
    limit = ["timeout", "--kill-after=30s", f"{int(p['timeout_minutes'])}m"]
    if profile == "check":
        return limit + ["bash", "-c", task["check"]]
    prompt = (ROOT / "templates" / "prompts" / f"{profile}.md").read_text()
    prompt = prompt.replace("{{TASK_ID}}", task_id).replace("{{PROJECT}}", project)
    argv = limit + ["claude", "-p", prompt, "--plugin-dir", str(ROOT / "plugin"), "--agent", p["agent"],
                    "--model", p["model"], "--max-turns", str(p["max_turns"]),
                    "--max-budget-usd", str(p["max_budget_usd"]), "--permission-mode", "auto",
                    "--permission-prompts", "none", "--output-format", "json"]
    if p.get("json_schema"):  # the CLI takes the schema as JSON text
        argv += ["--json-schema", json.dumps(schema.load(ROOT, p["json_schema"]), separators=(",", ":"))]
    if a["resume"]:
        argv += ["--resume", a["resume"]]
    return argv


def child_env(conf: dict, project: str, task_id: str) -> dict:
    user = pwd.getpwuid(os.geteuid())
    return {"HOME": user.pw_dir, "USER": user.pw_name, "LOGNAME": user.pw_name, "LANG": "C.UTF-8",
            "PATH": f"{ROOT}/bin:{user.pw_dir}/.local/bin:/usr/bin:/bin", "DISPLAY": conf.get("DISPLAY", ""),
            "TZ": conf.get("TZ_NAME", "UTC"), "ENGINEER_PROJECT": project, "ENGINEER_TASK_ID": task_id,
            "ENGINEER_UNATTENDED": "1"}


def run(profile: str, argv: list, wt: Path, env: dict, base_ref: str) -> dict:
    p = subprocess.run(argv, cwd=wt, env=env, stdin=subprocess.DEVNULL, capture_output=True)
    out, err = p.stdout.decode(errors="replace"), p.stderr.decode(errors="replace")
    lines = (out + ("\n" if out and not out.endswith("\n") else "") + err).splitlines()
    res = {"profile": profile, "exit_code": p.returncode, "timed_out": p.returncode in (124, 137),
           "session_id": None, "cost_usd": None, "num_turns": None, "subtype": None,
           "is_error": p.returncode != 0, "output_tail": "\n".join(lines[-TAIL_LINES:]), "permission_denials": []}
    if profile != "check":
        last = next((ln for ln in reversed(out.splitlines()) if ln.strip()), "")
        try:
            r = json.loads(last)
        except ValueError:
            r = None
        if isinstance(r, dict):
            res.update(session_id=r.get("session_id"), cost_usd=r.get("total_cost_usd"),
                       num_turns=r.get("num_turns"), subtype=r.get("subtype"),
                       permission_denials=r.get("permission_denials") or [])
            if isinstance(r.get("structured_output"), dict):
                res["structured_output"] = r["structured_output"]
            res["is_error"] = bool(r.get("is_error")) or p.returncode != 0
        else:
            res["is_error"] = True
    res.update(worktree.shas(wt, base_ref))
    return res


def main(argv: list) -> int:
    a = parse_args(argv)
    project, task_id, profile = a["pos"]
    for key in REFUSED_ENV:
        if os.environ.get(key):
            raise Refuse(78, f"{key} is set; runs use the Max /login only (John's decision 1)")
    conf = engconf.load(ROOT)
    if Path(conf["KILL_SWITCH"]).exists():
        raise Refuse(75, "kill switch is on")
    if not PROJECT_RE.fullmatch(project):
        raise Refuse(65, "bad project name")
    row = project_row(conf, project)
    profiles = yaml.safe_load((ROOT / "templates" / "run-defaults.yaml").read_text())["profiles"]
    if profile not in profiles:
        raise Refuse(65, f"unknown profile {profile}")
    if a["resume"] is not None and (profile != "implementer" or not SESSION_RE.fullmatch(a["resume"])):
        raise Refuse(65, "--resume takes a session id and only for the implementer profile")
    if profile != "check" and not (ROOT / "LOCKED").exists() and row.get("scratch") != "yes":
        raise Refuse(75, "not locked (setup-root --lock) and the project is not scratch=yes")
    clone = Path(conf["PROJECTS_DIR"]) / project
    task = find_task(clone, task_id)
    wt = Path(conf["PROJECTS_DIR"]) / f"{project}.wt" / task_id
    argv_ = build(conf, a, profiles, task, wt)
    env = child_env(conf, project, task_id)
    if a["dry_run"]:
        print(json.dumps({"argv": argv_, "cwd": str(wt), "env": env}))
        return 0
    try:
        base = worktree.ensure_worktree(clone, wt, f"task/{task_id}", row["default"],
                                        worktree.mirror_path(conf, project))
    except ValueError as e:
        raise Refuse(65, str(e))
    except subprocess.CalledProcessError as e:
        raise Refuse(65, f"cannot create the worktree: {(e.stderr or '').strip()[:200]}")
    print(json.dumps(run(profile, argv_, wt, env, base)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refuse as e:
        print(f"run-task: {e}", file=sys.stderr)
        sys.exit(e.code)
