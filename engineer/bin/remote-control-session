#!/bin/bash
set -euo pipefail
# remote-control-session: runs Remote Control in server mode (engineer-host E103; exact flags confirmed on setup day)
# as engineer, from PROJECTS_DIR. Started by its systemd unit. Auth is Path A (Claude Max via /login,
# John's decision 1): it refuses to start when an API key or OAuth token is in the environment.
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)

for var in ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN; do
  if [ -n "${!var+set}" ]; then
    echo "remote-control-session: refusing to start: $var is set; this host signs in with /login (Path A)" >&2
    exit 78
  fi
done

# shellcheck source=/dev/null
. "$root/etc/engineer.conf"
# A claude in <root>/bin (tests only) wins; the session keeps its own PATH.
claude=$(PATH="$root/bin:$PATH" command -v claude) || { echo "$(basename "$0"): claude not found" >&2; exit 69; }
cd "$PROJECTS_DIR"
exec "$claude" remote-control
